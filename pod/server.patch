+# Text stream specials: padding between words, and the last padding before a word.
+TEXT_PAD = 3
+TEXT_EPAD = 0
+# Speaking pace for words written on the agent's behalf, in 80 ms frames.
+FRAMES_PER_CHAR = 0.6
+PAUSE_FRAMES = {",": 2, ";": 2, ":": 2, ".": 4, "!": 4, "?": 4}
+
+
 @dataclass
+class RawPcmReader:
+    """Stands in for the Opus reader when the client sends plain 16-bit PCM at 24 kHz."""
+
+    def __init__(self):
+        self.pending = []
+
+    def append_bytes(self, data: bytes):
+        self.pending.append(np.frombuffer(data[: len(data) // 2 * 2], np.int16).astype(np.float32) / 32768)
+
+    def read_pcm(self):
+        out = np.concatenate(self.pending) if self.pending else np.zeros(0, np.float32)
+        self.pending = []
+        return out
+

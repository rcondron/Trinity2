+    def paced_tokens(self, text: str) -> list[int]:
+        """Text tokens that make the agent say `text` at a natural talking pace.
+
+        The model writes each word as it starts saying it and pads until the
+        next one, so the gap after a word is what sets how long it takes to say.
+        """
+        out = []
+        for word in text.split():
+            pieces = self.text_tokenizer.encode(word)
+            frames = max(len(pieces) + 1, round(len(word) * FRAMES_PER_CHAR) + 1)
+            frames += PAUSE_FRAMES.get(word[-1], 0)
+            out += [TEXT_EPAD] + pieces + [TEXT_PAD] * (frames - len(pieces) - 1)
+        return out
+

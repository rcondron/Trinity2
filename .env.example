# ─── Trinity engine configuration ───────────────────────────────────────────
# Copy this file to `.env` and fill in the keys you have. Trinity runs in mock
# mode for any service whose key is missing, so you can start with none of them.

# Server
PORT=8799
WEB_PORT=5173

# Voice — NVIDIA PersonaPlex  (https://fal.ai/models/fal-ai/personaplex)
# NOTE: the fal.ai PersonaPlex endpoint is marked DEPRECATED. It may still work,
# but the durable path is self-hosting (Runpod) — point PERSONAPLEX_URL there.
FAL_KEY=
PERSONAPLEX_URL=https://queue.fal.run/fal-ai/personaplex
PERSONAPLEX_VOICE=NATF2

# Decision / routing — Jev (TypeSafe AI) via OpenRouter (https://openrouter.ai)
# Confirm the exact model slug on OpenRouter; routing falls back to a heuristic on error.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev

# Brain — general-knowledge chat model (OpenRouter). Any capable chat model works.
BRAIN_MODEL=anthropic/claude-sonnet-5-5

# UI builder — Morph  (https://morphllm.com)
#   MORPH_MODEL     applies incremental edits to existing UI (fast-apply, edit-only)
#   MORPH_GEN_MODEL generates UI from scratch (a codegen model)
MORPH_API_KEY=
MORPH_MODEL=morph-v3-fast
MORPH_GEN_MODEL=morph-glm53-744b

# Web search — Tavily  (https://app.tavily.com)
TAVILY_API_KEY=

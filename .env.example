# ─── Trinity engine configuration ───────────────────────────────────────────
# Copy this file to `.env` and fill in the keys you have. Trinity runs in mock
# mode for any service whose key is missing, so you can start with none of them.

# Server
PORT=8799
WEB_PORT=5173
# The engine listens on 127.0.0.1 and only answers requests addressed to localhost.
# To use it from another device on your network: HOST=0.0.0.0 and list the names/IPs
# it may be reached by (they're accepted in the Host and Origin checks). No auth beyond
# that, so only do this on a network you trust.
# HOST=0.0.0.0
# ALLOWED_HOSTS=192.168.1.20,trinity.local

# Voice — NVIDIA PersonaPlex  (https://fal.ai/models/fal-ai/personaplex)
# Turn-based fallback via fal.ai (DEPRECATED endpoint; works but not streaming).
FAL_KEY=
PERSONAPLEX_URL=https://queue.fal.run/fal-ai/personaplex
PERSONAPLEX_VOICE=NATF2

# Real-time voice — a PATCHED, self-hosted PersonaPlex (streaming say/hold protocol).
# pod/ provisions it on a GPU pod (tested on Runpod, one 20 GB card; see README → Hosting
# PersonaPlex); fal's hosted endpoint can NOT do this. Point this at wss://<pod-proxy-host>.
# Leave blank to stay on the turn-based path.
PERSONAPLEX_WS_URL=

# Live transcription — Deepgram (https://deepgram.com). Required for the real-time loop.
DEEPGRAM_API_KEY=
# DEEPGRAM_URL=   # optional — override the default nova-3 listen URL
# REPLY_MODEL=nvidia-nemotron-3-nano-30b-a3b   # fast one-sentence reply writer (via Mordiem)

# Live-loop timing (optional; also editable in Settings)
# ROUTE_EVERY_MS=400
# MIN_CONFIDENCE=0.7
# FILLER_AFTER_MS=500

# Decision / routing — Jev (TypeSafe AI, direct System One API: https://docs.typesafe.ai)
# Routing falls back to a heuristic on error. Pin a version (e.g. jev-1.13.0) in production.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# Mordiem — the coding skill, the brain and the fast models, one OpenAI-compatible gateway.
#   The coding skill builds workspace UIs (and new skills) with one of two coders:
#   GLM (fast — the default) or Kimi (stronger, for big apps; also the fallback).
#   BRAIN_MODEL answers questions that need real knowledge or reasoning.
MORDIEM_API_KEY=
MORDIEM_URL=https://api.mordiem.com/api/v1
MORDIEM_GLM_MODEL=z-ai-glm-5-3-flash
MORDIEM_KIMI_MODEL=kimi-k3
CODER_DEFAULT=glm
BRAIN_MODEL=claude-sonnet-5-5

# Skills Trinity creates on the fly run in a sandbox. auto = usable at once after a sandbox
# test; manual = they wait in Settings → Skills for your approval.
SKILL_APPROVAL=auto

# Web search — Tavily  (https://app.tavily.com); keyless DuckDuckGo is used without it.
TAVILY_API_KEY=

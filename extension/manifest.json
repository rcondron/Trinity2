{
  "manifest_version": 3,
  "name": "Trinity Browser Bridge",
  "version": "0.2.1",
  "description": "Lets Trinity, the voice assistant running on this computer, control this whole browser: tabs and windows, reading pages, clicking and typing, restyling a site, saving files, signing in and filling forms from her vault, and taking what you share onto her workspace.",
  "minimum_chrome_version": "128",
  "permissions": ["tabs", "scripting", "downloads", "storage", "contextMenus", "pageCapture", "alarms", "userScripts", "sessions", "tabGroups", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Trinity",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
